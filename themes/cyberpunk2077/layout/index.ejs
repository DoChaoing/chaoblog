<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<%- partial('partial/head') %>
<body class="cyber-body">
  <!-- 載入遮罩 -->
  <div class="page-loader">
    <div class="loader-content">
      <div class="loader-glitch" data-text="LOADING">LOADING</div>
      <div class="loader-bar">
        <div class="loader-progress"></div>
      </div>
      <div class="loader-percent">0%</div>
    </div>
  </div>

  <!-- 背景效果層 -->
  <div class="cyber-bg">
    <div class="cyber-grid"></div>
    <div class="cyber-scanline"></div>
    <canvas id="particle-canvas"></canvas>
  </div>

  <%- partial('partial/header') %>
  
  <main class="site-main">
    <div class="container">
      <!-- Hero 區域 - Cyberpunk 2077 風格動畫 -->
      <section class="hero-section" data-animate="hero">
        <!-- Cyberpunk 2077 風格 Logo -->
        <div id="cyber-logo" class="cyber-logo">
          <!-- 主標題 -->
          <div class="logo-main">
            <!-- 青色層 (主層) -->
            <div class="logo-layer logo-cyan">
              <span class="logo-char">N</span>
              <span class="logo-char">e</span>
              <span class="logo-char">u</span>
              <span class="logo-char">r</span>
              <span class="logo-char">a</span>
              <span class="logo-char">l</span>
              <span class="logo-char">F</span>
              <span class="logo-char">l</span>
              <span class="logo-char">o</span>
              <span class="logo-char">w</span>
            </div>
            <!-- 粉色層 (Glitch 層) -->
            <div class="logo-layer logo-pink" aria-hidden="true">
              <span class="logo-char">N</span>
              <span class="logo-char">e</span>
              <span class="logo-char">u</span>
              <span class="logo-char">r</span>
              <span class="logo-char">a</span>
              <span class="logo-char">l</span>
              <span class="logo-char">F</span>
              <span class="logo-char">l</span>
              <span class="logo-char">o</span>
              <span class="logo-char">w</span>
            </div>
          </div>
          
          <!-- 副標題 -->
          <div class="logo-sub">
            <div class="sub-bg"></div>
            <div class="sub-text sub-text-en">
              <span class="sub-char">E</span>
              <span class="sub-char">x</span>
              <span class="sub-char">p</span>
              <span class="sub-char">l</span>
              <span class="sub-char">o</span>
              <span class="sub-char">r</span>
              <span class="sub-char">i</span>
              <span class="sub-char">n</span>
              <span class="sub-char">g</span>
              <span class="sub-char">&nbsp;</span>
              <span class="sub-char">A</span>
              <span class="sub-char">I</span>
              <span class="sub-char">&nbsp;</span>
              <span class="sub-char">·</span>
              <span class="sub-char">&nbsp;</span>
              <span class="sub-char">C</span>
              <span class="sub-char">o</span>
              <span class="sub-char">d</span>
              <span class="sub-char">e</span>
              <span class="sub-char">&nbsp;</span>
              <span class="sub-char">·</span>
              <span class="sub-char">&nbsp;</span>
              <span class="sub-char">F</span>
              <span class="sub-char">u</span>
              <span class="sub-char">t</span>
              <span class="sub-char">u</span>
              <span class="sub-char">r</span>
              <span class="sub-char">e</span>
            </div>
          </div>
          
          <!-- 裝飾元素 -->
          <div class="logo-decor">
            <span class="decor-line left"></span>
            <span class="decor-line right"></span>
            <span class="decor-dot dot-1"></span>
            <span class="decor-dot dot-2"></span>
          </div>
        </div>
        
        <!-- 描述文字 -->
        <p class="hero-desc">
          <span class="desc-bracket">[</span>
          <span class="desc-text">AI Engineer · Full-Stack Developer · Open Source Enthusiast</span>
          <span class="desc-bracket">]</span>
        </p>
        
        <!-- 統計數據 -->
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number" data-count="<%= site.posts.length %>">0</span>
            <span class="stat-label">ARTICLES</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number" data-count="<%= site.categories.length %>">0</span>
            <span class="stat-label">CATEGORIES</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number" data-count="<%= site.tags.length %>">0</span>
            <span class="stat-label">TAGS</span>
          </div>
        </div>
      </section>
      
      <!-- 系列分類卡片 -->
      <section class="series-section" data-animate="cards">
        <div class="section-header">
          <div class="section-line"></div>
          <h2 class="section-title">
            <span class="title-icon">◆</span>
            探索領域
            <span class="title-icon">◆</span>
          </h2>
          <div class="section-line"></div>
        </div>
        
        <div class="series-grid">
          <a href="<%- url_for('/categories/AI-Models/') %>" class="series-card" data-card="cpp">
            <div class="card-glow"></div>
            <div class="card-border"></div>
            <div class="card-content">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                </svg>
              </div>
              <h3 class="card-title">AI Models</h3>
              <p class="card-desc">大模型解析、LLM 原理、GPT、Claude、DeepSeek 等前沿 AI 技术</p>
              <div class="card-footer">
                <div class="card-tag">
                  <span class="tag-dot"></span>
                  探索 AI 核心
                </div>
                <div class="card-arrow">
                  <span>进入</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="card-hologram"></div>
          </a>
          
          <a href="<%- url_for('/categories/AI-Tools/') %>" class="series-card" data-card="flutter">
            <div class="card-glow"></div>
            <div class="card-border"></div>
            <div class="card-content">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
              </div>
              <h3 class="card-title">AI Tools</h3>
              <p class="card-desc">AI 编程工具横评、Cursor、Claude Code、Copilot 等开发利器</p>
              <div class="card-footer">
                <div class="card-tag">
                  <span class="tag-dot"></span>
                  效率神器
                </div>
                <div class="card-arrow">
                  <span>进入</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="card-hologram"></div>
          </a>
          
          <a href="<%- url_for('/categories/AI-Engineering/') %>" class="series-card" data-card="security">
            <div class="card-glow"></div>
            <div class="card-border"></div>
            <div class="card-content">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
              </div>
              <h3 class="card-title">AI Engineering</h3>
              <p class="card-desc">RAG、AI Agent、LangChain、工作流构建等工程实践</p>
              <div class="card-footer">
                <div class="card-tag">
                  <span class="tag-dot"></span>
                  工程落地
                </div>
                <div class="card-arrow">
                  <span>进入</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="card-hologram"></div>
          </a>
        </div>
      </section>
      
      <!-- 最新文章 -->
      <section class="recent-section" data-animate="posts">
        <div class="section-header">
          <div class="section-line"></div>
          <h2 class="section-title">
            <span class="title-icon">◆</span>
            最新文章
            <span class="title-icon">◆</span>
          </h2>
          <div class="section-line"></div>
        </div>
        
        <div class="posts-container">
          <% site.posts.sort('date', -1).slice(0, 5).forEach(function(post, index) { %>
            <article class="post-item" data-index="<%= index %>">
              <div class="post-index"><%= String(index + 1).padStart(2, '0') %></div>
              <a href="<%- url_for(post.path) %>" class="post-link">
                <div class="post-info">
                  <span class="post-category">
                    <% if (post.categories && post.categories.length) { %>
                      <%= post.categories.toArray()[0].name %>
                    <% } %>
                  </span>
                  <h3 class="post-title"><%= post.title %></h3>
                </div>
                <time class="post-date"><%= post.date.format('YYYY.MM.DD') %></time>
              </a>
              <div class="post-line"></div>
            </article>
          <% }); %>
        </div>
        
        <a href="<%- url_for('/archives/') %>" class="view-all-btn">
          <span class="btn-text">查看所有文章</span>
          <span class="btn-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
          <div class="btn-glow"></div>
        </a>
      </section>
    </div>
  </main>
  
  <!-- 側邊裝飾 -->
  <div class="side-decor left">
    <div class="decor-line"></div>
    <div class="decor-nodes">
      <span></span><span></span><span></span><span></span>
    </div>
  </div>
  <div class="side-decor right">
    <div class="decor-bars">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
  
  <%- partial('partial/footer') %>
</body>
</html>
