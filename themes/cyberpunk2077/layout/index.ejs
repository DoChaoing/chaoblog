<!DOCTYPE html>
<html lang="<%= config.language || 'zh-TW' %>">
<%- partial('partial/head') %>
<body class="cyber-body">
  <!-- 載入遮罩 -->
  <div class="page-loader">
    <div class="loader-content">
      <div class="loader-glitch" data-text="LOADING">LOADING</div>
      <div class="loader-bar">
        <div class="loader-progress"></div>
      </div>
      <div class="loader-percent">0%</div>
    </div>
  </div>

  <!-- 背景效果層 -->
  <div class="cyber-bg">
    <div class="cyber-grid"></div>
    <div class="cyber-scanline"></div>
    <canvas id="particle-canvas"></canvas>
  </div>

  <%- partial('partial/header') %>
  
  <main class="site-main">
    <div class="container">
      <!-- Hero 區域 - Cyberpunk 2077 風格動畫 -->
      <section class="hero-section" data-animate="hero">
        <!-- Cyberpunk 2077 風格 Logo -->
        <div id="cyber-logo" class="cyber-logo">
          <!-- 站点标题 -->
          <div class="logo-main">
            <div class="logo-layer logo-cyan">
              <% Array.from(config.title || 'BLOG').forEach(function(char) { %>
                <span class="logo-char"><%= char %></span>
              <% }); %>
            </div>
            <div class="logo-layer logo-pink" aria-hidden="true">
              <% Array.from(config.title || 'BLOG').forEach(function(char) { %>
                <span class="logo-char"><%= char %></span>
              <% }); %>
            </div>
          </div>
          
          <!-- 站点副标题 -->
          <div class="logo-sub">
            <div class="sub-bg"></div>
            <div class="sub-text sub-text-en">
              <% Array.from(config.subtitle || 'AI ENGINEERING NOTES').forEach(function(char) { %>
                <span class="sub-char"><%= char === ' ' ? '\u00a0' : char %></span>
              <% }); %>
            </div>
          </div>
          
          <!-- 裝飾元素 -->
          <div class="logo-decor">
            <span class="decor-line left"></span>
            <span class="decor-line right"></span>
            <span class="decor-dot dot-1"></span>
            <span class="decor-dot dot-2"></span>
          </div>
        </div>
        
        <!-- 描述文字 -->
        <p class="hero-desc">
          <span class="desc-bracket">[</span>
          <span class="desc-text"><%= config.description || '记录 AI 学习与工程实践' %></span>
          <span class="desc-bracket">]</span>
        </p>
        
        <!-- 統計數據 -->
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number" data-count="<%= site.categories.length %>">0</span>
            <span class="stat-label">分类</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number" data-count="<%= site.posts.length %>">0</span>
            <span class="stat-label">文章</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number" data-count="<%= site.posts.length ? site.posts.sort('date', -1).first().date.year() : new Date().getFullYear() %>">0</span>
            <span class="stat-label">年份</span>
          </div>
        </div>
      </section>
      
      <!-- 核心入口 -->
      <section class="series-section" data-animate="cards">
        <div class="section-header">
          <div class="section-line"></div>
          <h2 class="section-title">
            <span class="title-icon">◆</span>
            AI 学习入口
            <span class="title-icon">◆</span>
          </h2>
          <div class="section-line"></div>
        </div>

        <div class="series-grid">
          <a href="<%- url_for('/ai-learning/') %>" class="series-card" data-card="cpp">
            <div class="card-glow"></div><div class="card-border"></div>
            <div class="card-content">
              <div class="card-icon"><span aria-hidden="true">01</span></div>
              <h3 class="card-title">零基础学 AI</h3>
              <p class="card-desc">先明确目标，再按路线完成第一个可验证的学习成果</p>
              <div class="card-footer"><div class="card-tag"><span class="tag-dot"></span>LEARNING PATH</div><div class="card-arrow"><span>开始</span></div></div>
            </div><div class="card-hologram"></div>
          </a>
          <a href="<%- url_for('/projects/') %>" class="series-card" data-card="flutter">
            <div class="card-glow"></div><div class="card-border"></div>
            <div class="card-content">
              <div class="card-icon"><span aria-hidden="true">02</span></div>
              <h3 class="card-title">AI 项目实战</h3>
              <p class="card-desc">用 Python、RAG 和 Agent 做出能够运行与验收的项目</p>
              <div class="card-footer"><div class="card-tag"><span class="tag-dot"></span>BUILD & VERIFY</div><div class="card-arrow"><span>查看</span></div></div>
            </div><div class="card-hologram"></div>
          </a>
          <a href="<%- url_for('/interview/') %>" class="series-card" data-card="security">
            <div class="card-glow"></div><div class="card-border"></div>
            <div class="card-content">
              <div class="card-icon"><span aria-hidden="true">03</span></div>
              <h3 class="card-title">AI 面试准备</h3>
              <p class="card-desc">从原理、项目表达和系统设计三个层面准备技术面试</p>
              <div class="card-footer"><div class="card-tag"><span class="tag-dot"></span>INTERVIEW</div><div class="card-arrow"><span>准备</span></div></div>
            </div><div class="card-hologram"></div>
          </a>
        </div>
      </section>

      <!-- 真实分类卡片 -->
      <section class="series-section" data-animate="cards">
        <div class="section-header">
          <div class="section-line"></div>
          <h2 class="section-title">
            <span class="title-icon">◆</span>
            内容分类
            <span class="title-icon">◆</span>
          </h2>
          <div class="section-line"></div>
        </div>
        
        <div class="series-grid">
          <% var cardStyles = ['cpp', 'flutter', 'security']; %>
          <% site.categories.sort('name').forEach(function(category, index) { %>
          <a href="<%- url_for(category.path) %>" class="series-card" data-card="<%= cardStyles[index % cardStyles.length] %>">
            <div class="card-glow"></div>
            <div class="card-border"></div>
            <div class="card-content">
              <div class="card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 4h16v16H4z"/>
                  <path d="M8 9h8M8 13h8M8 17h5"/>
                </svg>
              </div>
              <h3 class="card-title"><%= category.name %></h3>
              <p class="card-desc"><%= (theme.category_descriptions && theme.category_descriptions[category.name]) || ('查看“' + category.name + '”分类下的全部文章') %></p>
              <div class="card-footer">
                <div class="card-tag">
                  <span class="tag-dot"></span>
                  <%= category.posts.length %> 篇文章
                </div>
                <div class="card-arrow">
                  <span>进入</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="card-hologram"></div>
          </a>
          <% }); %>
        </div>
      </section>
      
      <!-- 最新文章 -->
      <section class="recent-section" data-animate="posts">
        <div class="section-header">
          <div class="section-line"></div>
          <h2 class="section-title">
            <span class="title-icon">◆</span>
            最新文章
            <span class="title-icon">◆</span>
          </h2>
          <div class="section-line"></div>
        </div>
        
        <div class="posts-container">
          <% site.posts.sort('date', -1).slice(0, 5).forEach(function(post, index) { %>
            <article class="post-item" data-index="<%= index %>">
              <div class="post-index"><%= String(index + 1).padStart(2, '0') %></div>
              <a href="<%- url_for(post.path) %>" class="post-link">
                <div class="post-info">
                  <span class="post-category">
                    <% if (post.categories && post.categories.length) { %>
                      <%= post.categories.toArray()[0].name %>
                    <% } %>
                  </span>
                  <h3 class="post-title"><%= post.title %></h3>
                </div>
                <time class="post-date"><%= post.date.format('YYYY.MM.DD') %></time>
              </a>
              <div class="post-line"></div>
            </article>
          <% }); %>
        </div>
        
        <a href="<%- url_for('/archives/') %>" class="view-all-btn">
          <span class="btn-text">查看所有文章</span>
          <span class="btn-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
          <div class="btn-glow"></div>
        </a>
      </section>
    </div>
  </main>
  
  <!-- 側邊裝飾 -->
  <div class="side-decor left">
    <div class="decor-line"></div>
    <div class="decor-nodes">
      <span></span><span></span><span></span><span></span>
    </div>
  </div>
  <div class="side-decor right">
    <div class="decor-bars">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
  
  <%- partial('partial/footer') %>
</body>
</html>
